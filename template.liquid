<div class="view view--full">
  <div class="layout layout--col gap--large portrait:gap--xlarge" style="height: 100%; justify-content: center; align-items: center; text-align: center;">
    <span class="label label--underline label--base lg:label--large">USD / INR</span>
    <span class="value value--xxlarge lg:value--giga">₹{{ usd_inr }}</span>
    {% if usd_inr_prev %}
      {% if usd_inr > usd_inr_prev %}
        <span class="description text--large lg:description--large">&uarr; from ₹{{ usd_inr_prev }}</span>
      {% elsif usd_inr < usd_inr_prev %}
        <span class="description text--large lg:description--large">&darr; from ₹{{ usd_inr_prev }}</span>
      {% else %}
        <span class="description text--large lg:description--large">unchanged</span>
      {% endif %}
    {% endif %}

    <span class="label label--underline label--base lg:label--large" style="margin-top: 20px;">EUR / INR</span>
    <span class="value value--xxlarge lg:value--giga">₹{{ eur_inr }}</span>
    {% if eur_inr_prev %}
      {% if eur_inr > eur_inr_prev %}
        <span class="description text--large lg:description--large">&uarr; from ₹{{ eur_inr_prev }}</span>
      {% elsif eur_inr < eur_inr_prev %}
        <span class="description text--large lg:description--large">&darr; from ₹{{ eur_inr_prev }}</span>
      {% else %}
        <span class="description text--large lg:description--large">unchanged</span>
      {% endif %}
    {% endif %}
  </div>
</div>

<div class="title_bar">
  <span class="title">Currency Rates</span>
  <span class="instance">{{ rate_date }}</span>
</div>
