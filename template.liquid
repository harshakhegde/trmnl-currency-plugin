<div class="view view--full">
  <div class="layout layout--col gap--large" style="height: 100%; justify-content: center; align-items: center; text-align: center;">
    <span class="label label--underline">USD / INR</span>
    <span class="value value--xxlarge">₹{{ usd_inr }}</span>
    {% if usd_inr_prev %}
      {% if usd_inr > usd_inr_prev %}
        <span class="description text--large">&uarr; from ₹{{ usd_inr_prev }}</span>
      {% elsif usd_inr < usd_inr_prev %}
        <span class="description text--large">&darr; from ₹{{ usd_inr_prev }}</span>
      {% else %}
        <span class="description text--large">unchanged</span>
      {% endif %}
    {% endif %}

    <span class="label label--underline" style="margin-top: 20px;">EUR / INR</span>
    <span class="value value--xxlarge">₹{{ eur_inr }}</span>
    {% if eur_inr_prev %}
      {% if eur_inr > eur_inr_prev %}
        <span class="description text--large">&uarr; from ₹{{ eur_inr_prev }}</span>
      {% elsif eur_inr < eur_inr_prev %}
        <span class="description text--large">&darr; from ₹{{ eur_inr_prev }}</span>
      {% else %}
        <span class="description text--large">unchanged</span>
      {% endif %}
    {% endif %}
  </div>
</div>

<div class="title_bar">
  <span class="title">Currency Rates</span>
  <span class="instance">{{ rate_date }}</span>
</div>
