<div class="view view--half_vertical">
  <div class="layout layout--col gap--medium" style="height: 100%; justify-content: center; align-items: center; text-align: center;">
    <span class="label label--underline">USD/INR</span>
    <span class="value value--xlarge">₹{{ usd_inr }}</span>
    <span class="label label--underline" style="margin-top: 12px;">EUR/INR</span>
    <span class="value value--xlarge">₹{{ eur_inr }}</span>
  </div>
</div>

<div class="title_bar">
  <span class="title">Currency Rates</span>
  <span class="instance">{{ rate_date }}</span>
</div>
