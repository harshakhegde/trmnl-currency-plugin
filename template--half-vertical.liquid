<div class="view view--half_vertical">
  <div class="layout layout--col gap--medium lg:gap--large" style="height: 100%; justify-content: center; align-items: center; text-align: center;">
    <span class="label label--underline label--base lg:label--large">USD/INR</span>
    <span class="value value--xlarge lg:value--tera">₹{{ usd_inr }}</span>
    <span class="label label--underline label--base lg:label--large" style="margin-top: 12px;">EUR/INR</span>
    <span class="value value--xlarge lg:value--tera">₹{{ eur_inr }}</span>
  </div>
</div>

<div class="title_bar">
  <span class="title">Currency Rates</span>
  <span class="instance">{{ rate_date }}</span>
</div>
